{
	"name": "softio",
	"version": "4.1.0",
	"description": "Elegant and unified terminal I/O for Node.js — simplify reading input, writing output, and controlling the console with ease.",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"scripts": {
		"bench:speed": "node ./benchmark/speed.js",
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"build": "tsup",
		"test": "vitest run"
	},
	"files": [
		"./dist/main.js",
		"./dist/main.d.ts",
		"./README.md",
		"./LICENSE"
	],
	"keywords": [
		"softio",
		"console",
		"terminal",
		"nodejs",
		"typescript",
		"javascript",
		"stdio",
		"stdout",
		"stdin",
		"readline",
		"input",
		"output",
		"cli",
		"cli-tool",
		"console-app",
		"console-utility",
		"text-ui",
		"ansi-colors",
		"interactive-cli"
	],
	"author": "Softio Contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AryaFardmanesh/softio.git"
	},
	"bugs": {
		"url": "https://github.com/AryaFardmanesh/softio/issues",
		"email": "AryaFardmanesh.1383@gmail.com"
	},
	"homepage": "https://github.com/AryaFardmanesh/softio#readme",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^25.9.1",
		"tsup": "^8.5.1",
		"typescript": "^5.7.2",
		"vitest": "^5.0.3"
	}
}
